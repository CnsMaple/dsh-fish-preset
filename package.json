{
  "name": "dsh-fish-preset",
  "version": "0.1.0",
  "repository": { "type": "git", "url": "git+https://github.com/CnsMaple/dsh-fish-preset.git" },
  "homepage": "https://github.com/CnsMaple/dsh-fish-preset#readme",
  "bugs": { "url": "https://github.com/CnsMaple/dsh-fish-preset/issues" },
  "description": "Fish：基于 ptc 的 DSH agent 预设，额外启用 apply_patch（一次调用完成多文件补丁编辑）。",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "apply-patch",
    "ptc",
    "cordis"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      }
    }
  }
}
